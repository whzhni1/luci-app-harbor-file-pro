window.HarborFile.tr = function (msgid) {
    var labels = (window.HarborFile && window.HarborFile.labels) || {};

    
    if (typeof window._ === 'function' && window._ !== window.HarborFile.tr) {
        var translated = window._(msgid);
        if (translated && translated !== msgid) {
            return translated;
        }
    }

    
    if (labels[msgid] !== undefined && labels[msgid] !== null && labels[msgid] !== '') {
        return labels[msgid];
    }
    var snake = String(msgid).toLowerCase().replace(/[^a-z0-9]+/g, '_').replace(/^_+|_+$/g, '');
    if (labels[snake] !== undefined && labels[snake] !== null && labels[snake] !== '') {
        return labels[snake];
    }

    
    var alias = {
        'ASCII': 'ascii_label',
        'Image': 'image_title',
        'PDF': 'pdf_title',
        'Video': 'video_title',
        'Nginx': 'nginx_name',
        'Saving ': 'saving_progress',
        'Enter hex bytes, e.g. DE AD BE EF': 'hex_search_placeholder',
        'Replace hex value': 'hex_replace_placeholder',
        'Hex replacement must match the match length': 'hex_replace_length_mismatch',
        'Please enter an absolute path starting with /': 'enter_absolute_path'
    };
    if (alias[msgid] !== undefined && labels[alias[msgid]] !== undefined && labels[alias[msgid]] !== null && labels[alias[msgid]] !== '') {
        return labels[alias[msgid]];
    }

    return msgid;
};
