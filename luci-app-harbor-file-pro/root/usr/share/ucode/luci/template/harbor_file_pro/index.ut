    <div class="fm-dialog-header">
        <div id="fm_package_install_title" class="fm-dialog-title">{{ _('Installing package') }}</div>
        <button id="fm_package_install_close" class="fm-dialog-close" type="button" aria-label="{{ _('Close') }}">&times;</button>
    </div>
    <div class="fm-package-install-body">
        <div id="fm_package_install_status" class="fm-package-status">-</div>
        <div id="fm_install_progress_wrap" class="fm-thumbnail-progress" style="display:none"><span id="fm_install_progress_bar"></span></div>
        <div class="fm-package-list">
            <div class="fm-package-label">{{ _('Name') }}</div><div id="fm_package_install_name" class="fm-package-value">-</div>
            <div class="fm-package-label">{{ _('Path') }}</div><div id="fm_package_install_path" class="fm-package-value">-</div>
            <div class="fm-package-label">{{ _('Type') }}</div><div id="fm_package_install_type" class="fm-package-value">-</div>
            <div class="fm-package-label">{{ _('Installer') }}</div><div id="fm_package_install_installer" class="fm-package-value">-</div>
            <div class="fm-package-label">{{ _('Exit code') }}</div><div id="fm_package_install_exit" class="fm-package-value">-</div>
        </div>
        <pre id="fm_package_install_log" class="fm-package-log">{{ _('No log yet') }}</pre>
    </div>
    <div class="fm-dialog-actions">
        <button id="fm_package_install_done" class="fm-dialog-action primary" type="button">{{ _('Close') }}</button>
    </div>
</section>

<section id="fm_thumbnail_dialog" class="fm-dialog fm-text-dialog" role="dialog" aria-modal="true" aria-labelledby="fm_thumbnail_title">
    <div class="fm-dialog-header">
        <div id="fm_thumbnail_title" class="fm-dialog-title">{{ _('Generating thumbnails') }}</div>
        <button id="fm_thumbnail_close" class="fm-dialog-close" type="button" aria-label="{{ _('Close') }}">&times;</button>
    </div>
    <div class="fm-package-install-body">
        <div id="fm_thumbnail_status" class="fm-package-status">-</div>
        <div class="fm-thumbnail-progress"><span id="fm_thumbnail_progress_bar"></span></div>
        <div class="fm-package-list">
            <div class="fm-package-label">{{ _('Path') }}</div><div id="fm_thumbnail_path" class="fm-package-value">-</div>
            <div class="fm-package-label">{{ _('Current file') }}</div><div id="fm_thumbnail_current" class="fm-package-value">-</div>
            <div class="fm-package-label">{{ _('Progress') }}</div><div id="fm_thumbnail_progress_text" class="fm-package-value">-</div>
            <div class="fm-package-label">{{ _('Generated') }}</div><div id="fm_thumbnail_success" class="fm-package-value">-</div>
            <div class="fm-package-label">{{ _('Cached') }}</div><div id="fm_thumbnail_cached" class="fm-package-value">-</div>
            <div class="fm-package-label">{{ _('Failed') }}</div><div id="fm_thumbnail_failed" class="fm-package-value">-</div>
        </div>
        <pre id="fm_thumbnail_log" class="fm-package-log">{{ _('No log yet') }}</pre>
    </div>
    <div class="fm-dialog-actions">
        <button id="fm_thumbnail_install_tool" class="fm-dialog-action primary" type="button" style="display:none">{{ _('Install GraphicsMagick') }}</button>
        <button id="fm_thumbnail_done" class="fm-dialog-action primary" type="button">{{ _('Close') }}</button>
    </div>
</section>


<section id="fm_terminal_dialog" class="fm-dialog fm-terminal-dialog" role="dialog" aria-modal="true" aria-labelledby="fm_terminal_title">
    <div class="fm-dialog-header">
        <div id="fm_terminal_title" class="fm-dialog-title">{{ _('Terminal') }}</div>
        <button class="fm-dialog-close" type="button" aria-label="{{ _('Close') }}">&times;</button>
    </div>
    <div class="fm-terminal-shell">
        <iframe id="fm_terminal_frame" class="fm-terminal-frame" src="about:blank" title="{{ _('Terminal') }}"></iframe>
        <div id="fm_terminal_loading" class="fm-terminal-overlay show">
            <div class="fm-terminal-panel">
                <div class="fm-terminal-spinner"></div>
                <div id="fm_terminal_loading_text" class="fm-terminal-message">{{ _('Connecting to terminal') }}</div>
                <div id="fm_terminal_loading_hint" class="fm-terminal-subtext"></div>
            </div>
        </div>
        <div id="fm_terminal_error" class="fm-terminal-overlay fm-terminal-error">
            <div class="fm-terminal-panel">
                <div id="fm_terminal_error_text" class="fm-terminal-message">{{ _('Terminal connection failed') }}</div>
                <div id="fm_terminal_error_hint" class="fm-terminal-subtext">{{ _('Connection failed, please check whether the ttyd service is running and the port is correct') }}</div>
                <button id="fm_terminal_install_tool" class="fm-dialog-action primary" type="button" style="display:none">{{ _('Install terminal plugin') }}</button>
                <button id="fm_terminal_open_external" class="fm-dialog-action" type="button" style="display:none">{{ _('Open terminal in a new window') }}</button>
            </div>
        </div>
    </div>
</section>
<script type="text/javascript">
(function (HF) {
    document.getElementById('fm_back').addEventListener('click', function() {
        if (HF.state.history_index > 0) {
            HF.state.history_index--;
            HF.navigate(HF.state.history[HF.state.history_index], false);
        }
    });
    document.getElementById('fm_forward').addEventListener('click', function() {
        if (HF.state.history_index < HF.state.history.length - 1) {
            HF.state.history_index++;
            HF.navigate(HF.state.history[HF.state.history_index], false);
        }
    });
    document.getElementById('fm_up').addEventListener('click', function() {
        if (!HF.state.current || HF.state.current.kind !== 'directory') {
            return;
        }
        if (HF.state.current.path === '/') {
            HF.show_virtual('this_pc', true);
        } else {
            HF.open_path(HF.state.current.parent || '/', true);
        }
    });
    document.getElementById('fm_refresh').addEventListener('click', function() {
        HF.refresh_current();
    });
    document.getElementById('fm_view').addEventListener('click', function(event) {
        event.stopPropagation();
        for (var i = 0; i < view_buttons.length; i++) {
            view_buttons[i].classList.toggle('active', view_buttons[i].getAttribute('data-view') === HF.state.view_mode);
        }
        var rect = document.getElementById('fm_more').getBoundingClientRect();
        HF.show_context_menu('fm_view_menu', rect.left, rect.bottom + 4);
    });
    document.getElementById('fm_select_mode').addEventListener('click', function() {
        HF.hide_context_menus();
        HF.handle_selection_button();
    });
    document.getElementById('fm_select_exit').addEventListener('click', function() {
        HF.hide_context_menus();
        HF.exit_selection_mode();
    });
    document.getElementById('fm_settings').addEventListener('click', function() {
        HF.hide_context_menus();
        HF.open_settings_dialog();
    });
    document.getElementById('fm_about').addEventListener('click', function() {
        HF.hide_context_menus();
        var mirror_select = document.getElementById('fm_update_mirror');
        mirror_select.value = HF.state.preferences.update_mirror || 'auto';
        HF.open_modal('fm_about_dialog');
        HF.check_update();
    });
    var openwith_types = { fm_openwith_text: 'text', fm_openwith_image: 'image', fm_openwith_video: 'video', fm_openwith_pdf: 'pdf', fm_openwith_hex: 'hex' };
    Object.keys(openwith_types).forEach(function(openwith_id) {
        document.getElementById(openwith_id).addEventListener('click', function() {
            var item = HF.state.openwith_item;
            var open_type = openwith_types[openwith_id];
            var remember = document.getElementById('fm_openwith_remember').checked;
            HF.close_modal();
            if (item) {
                if (remember) { HF.remember_open_type(item, open_type); }
                HF.open_item(item, open_type);
            }
        });
    });
    document.getElementById('fm_update_check').addEventListener('click', function() { HF.check_update(); });
    document.getElementById('fm_update_start').addEventListener('click', function() { HF.start_update(); });
    document.getElementById('fm_update_mirror').addEventListener('change', function() {
        HF.reset_update_result();
        HF.save_preferences({ section: 'basic', update_mirror: this.value }, '', null);
    });
    var view_buttons = document.querySelectorAll('#fm_view_menu [data-view]');
    for (var view_index = 0; view_index < view_buttons.length; view_index++) {
        view_buttons[view_index].addEventListener('click', function() {
            HF.set_view_mode(this.getAttribute('data-view'));
        });
    }
    document.getElementById('fm_menu_sort').addEventListener('mouseenter', HF.show_sort_menu);
    document.getElementById('fm_menu_sort').addEventListener('click', function(event) {
        event.preventDefault();
        event.stopPropagation();
        HF.show_sort_menu();
    });
    document.getElementById('fm_blank_menu').addEventListener('mousemove', function(event) {
        if (!event.target.closest('#fm_menu_sort')) {
            document.getElementById('fm_sort_menu').style.display = 'none';
        }
    });
    var sort_field_buttons = document.querySelectorAll('#fm_sort_menu [data-sort-field]');
    for (var sort_field_index = 0; sort_field_index < sort_field_buttons.length; sort_field_index++) {
        sort_field_buttons[sort_field_index].addEventListener('click', function(event) {
            event.stopPropagation();
            HF.apply_directory_sort(this.getAttribute('data-sort-field'), null);
        });
    }
    var sort_order_buttons = document.querySelectorAll('#fm_sort_menu [data-sort-order]');
    for (var sort_order_index = 0; sort_order_index < sort_order_buttons.length; sort_order_index++) {
        sort_order_buttons[sort_order_index].addEventListener('click', function(event) {
            event.stopPropagation();
            HF.apply_directory_sort(null, this.getAttribute('data-sort-order'));
        });
    }
    document.getElementById('fm_upload_input').addEventListener('change', function() {
        var files = Array.prototype.slice.call(this.files || []);
        var target = HF.state.upload_target;
        this.value = '';
        HF.state.upload_target = null;
        if (target) {
            HF.begin_upload(files, target.path, target.label);
        }
    });
    document.getElementById('fm_name_cancel').addEventListener('click', HF.close_modal);
    document.getElementById('fm_delete_cancel').addEventListener('click', HF.close_modal);
    document.getElementById('fm_settings_basic_cancel').addEventListener('click', HF.close_modal);
    document.getElementById('fm_settings_nginx_cancel').addEventListener('click', HF.close_modal);
    document.getElementById('fm_nginx_confirm_cancel').addEventListener('click', HF.close_modal);
    document.getElementById('fm_nginx_install_done').addEventListener('click', HF.close_modal);
    document.getElementById('fm_package_confirm_cancel').addEventListener('click', HF.close_modal);
    document.getElementById('fm_package_install_done').addEventListener('click', HF.close_modal);
    document.getElementById('fm_archive_cancel').addEventListener('click', HF.close_modal);
    document.getElementById('fm_archive_task_done').addEventListener('click', HF.close_modal);
    document.getElementById('fm_archive_install_tool').addEventListener('click', HF.start_archive_tool_install);
    document.getElementById('fm_archive_format').addEventListener('change', HF.sync_archive_format_options);
    document.getElementById('fm_archive_start').addEventListener('click', HF.submit_archive_dialog);
    document.getElementById('fm_extract_cancel').addEventListener('click', HF.close_modal);
    document.getElementById('fm_extract_start').addEventListener('click', HF.submit_extract_dialog);
    document.getElementById('fm_extract_all').addEventListener('change', HF.set_all_extract_entries);
    document.getElementById('fm_extract_list').addEventListener('change', HF.on_extract_row_change);
    document.getElementById('fm_extract_list').addEventListener('click', HF.on_extract_list_click);
    document.getElementById('fm_extract_target').addEventListener('keydown', function(event) {
        if (event.key === 'Enter') {
            event.preventDefault();
            HF.submit_extract_dialog();
        }
    });
    document.getElementById('fm_archive_name').addEventListener('keydown', function(event) {
        if (event.key === 'Enter') {
            event.preventDefault();
            HF.submit_archive_dialog();
        }
    });
    document.getElementById('fm_thumbnail_done').addEventListener('click', HF.close_modal);
    document.getElementById('fm_thumbnail_install_tool').addEventListener('click', HF.start_thumbnail_tool_install);
    document.getElementById('fm_terminal_install_tool').addEventListener('click', HF.start_terminal_tool_install);
    document.getElementById('fm_terminal_open_external').addEventListener('click', HF.open_terminal_external);
    document.getElementById('fm_package_confirm_start').addEventListener('click', function() {
        if (HF.state.install_item) {
            HF.start_package_install(HF.state.install_item);
        }
    });
    document.getElementById('fm_settings_basic_save').addEventListener('click', HF.save_basic_settings_dialog);
    document.getElementById('fm_settings_nginx_save').addEventListener('click', HF.save_web_server_settings_dialog);
    document.getElementById('fm_nginx_recommend').addEventListener('click', HF.use_recommended_nginx_settings);
    document.getElementById('fm_nginx_install').addEventListener('click', HF.open_nginx_install_confirm);
    document.getElementById('fm_nginx_confirm_start').addEventListener('click', HF.start_nginx_install);
    document.getElementById('fm_settings_client_max_body_size').addEventListener('input', HF.render_nginx_body_size_unit);
    document.getElementById('fm_settings_reload_on_as_enabled').addEventListener('change', HF.sync_uwsgi_toggle_inputs);
    document.getElementById('fm_settings_reload_on_rss_enabled').addEventListener('change', HF.sync_uwsgi_toggle_inputs);
    var settings_tabs = document.querySelectorAll('[data-settings-tab]');
    for (var settings_tab_index = 0; settings_tab_index < settings_tabs.length; settings_tab_index++) {
        settings_tabs[settings_tab_index].addEventListener('click', function() {
            HF.set_settings_tab(this.getAttribute('data-settings-tab'));
        });
    }
    document.getElementById('fm_overwrite_confirm').addEventListener('click', function() {
        var batch = HF.state.pending_upload;
        HF.state.pending_upload = null;
        HF.close_modal();
        if (batch) {
            HF.upload_batch(batch);
        }
    });
    document.getElementById('fm_menu_open').addEventListener('click', function() {
        HF.open_item(HF.state.context_item);
    });
    document.getElementById('fm_menu_open_binary').addEventListener('click', function() {
        HF.hide_context_menus();
        HF.open_binary(HF.state.context_item);
    });
    document.getElementById('fm_menu_properties').addEventListener('click', function() {
        HF.hide_context_menus();
        HF.open_properties(HF.state.context_item);
    });
    document.getElementById('fm_menu_terminal').addEventListener('click', function() {
        HF.open_terminal(HF.state.context_item);
    });
    document.getElementById('fm_menu_download').addEventListener('click', function() {
        HF.hide_context_menus();
        HF.trigger_download(HF.state.context_item);
    });
    document.getElementById('fm_menu_compress').addEventListener('click', function() {
        var items = HF.context_selection(HF.state.context_item);
        HF.hide_context_menus();
        HF.open_archive_dialog(items);
    });
    document.getElementById('fm_menu_extract').addEventListener('click', function() {
        var item = HF.state.context_item;
        HF.hide_context_menus();
        HF.start_archive_extract(item);
    });
    document.getElementById('fm_menu_copy').addEventListener('click', function() {
        HF.hide_context_menus();
        HF.set_clipboard('copy', HF.context_selection(HF.state.context_item));
    });
    document.getElementById('fm_menu_cut').addEventListener('click', function() {
        HF.hide_context_menus();
        HF.set_clipboard('cut', HF.context_selection(HF.state.context_item));
    });
    document.getElementById('fm_menu_paste').addEventListener('click', function() {
        var item = HF.state.context_item;
        if (item && item.type === 'directory') {
            HF.run_paste(item.path);
        }
    });
    document.getElementById('fm_menu_upload').addEventListener('click', function() {
        var item = HF.state.context_item;
        HF.hide_context_menus();
        if (item && item.type === 'directory') {
            HF.trigger_upload(item.path, item.name);
        }
    });
    document.getElementById('fm_menu_rename').addEventListener('click', function() {
        var item = HF.state.context_item;
        HF.hide_context_menus();
        HF.open_name_dialog('rename', item);
    });
    document.getElementById('fm_menu_delete').addEventListener('click', function() {
        var items = HF.context_selection(HF.state.context_item);
        HF.hide_context_menus();
        HF.open_delete_dialog(items);
    });
    document.getElementById('fm_menu_copy_to').addEventListener('click', function() {
        var items = HF.context_selection(HF.state.context_item);
        HF.hide_context_menus();
        HF.open_transfer_dialog('copy', items);
    });
    document.getElementById('fm_menu_move_to').addEventListener('click', function() {
        var items = HF.context_selection(HF.state.context_item);
        HF.hide_context_menus();
        HF.open_transfer_dialog('move', items);
    });
    document.getElementById('fm_menu_new_folder').addEventListener('click', function() {
        HF.hide_context_menus();
        if (HF.state.current && HF.state.current.kind === 'directory' && !HF.get_write_block_reason(HF.state.current.path)) {
            HF.open_name_dialog('create');
        } else {
            HF.set_write_block_status(HF.state.current ? HF.get_write_block_reason(HF.state.current.path) : HF.labels.system_folder_blocked);
        }
    });
    document.getElementById('fm_menu_new_file').addEventListener('click', function() {
        HF.hide_context_menus();
        if (HF.state.current && HF.state.current.kind === 'directory' && !HF.get_write_block_reason(HF.state.current.path)) {
            HF.open_name_dialog('create_file');
        } else {
            HF.set_write_block_status(HF.state.current ? HF.get_write_block_reason(HF.state.current.path) : HF.labels.system_folder_blocked);
        }
    });
    document.getElementById('fm_menu_paste_here').addEventListener('click', function() {
        if (HF.state.current && HF.state.current.kind === 'directory') {
            HF.run_paste(HF.state.current.path);
        } else {
            HF.hide_context_menus();
            HF.set_warning_status(HF.labels.clipboard_empty);
        }
    });
    document.getElementById('fm_menu_upload_here').addEventListener('click', function() {
        HF.hide_context_menus();
        if (HF.state.current && HF.state.current.kind === 'directory' && HF.can_upload_to_path(HF.state.current.path)) {
            HF.trigger_upload(HF.state.current.path, HF.path_title(HF.state.current.path));
        } else {
            HF.set_write_block_status(HF.state.current ? HF.get_write_block_reason(HF.state.current.path) : HF.labels.system_folder_blocked);
        }
    });
    document.getElementById('fm_menu_terminal_here').addEventListener('click', function() {
        HF.open_terminal(null);
    });
    document.getElementById('fm_menu_refresh').addEventListener('click', function() {
        HF.hide_context_menus();
        HF.refresh_current();
    });
    document.getElementById('fm_name_confirm').addEventListener('click', HF.submit_name_dialog);
    document.getElementById('fm_name_input').addEventListener('keydown', function(event) {
        if (event.key === 'Enter') {
            event.preventDefault();
            HF.submit_name_dialog();
        }
    });
    document.getElementById('fm_delete_confirm').addEventListener('click', function() {
        var items = HF.normalize_item_list(HF.state.delete_items && HF.state.delete_items.length ? HF.state.delete_items : [HF.state.delete_item]);
        HF.close_modal();
        if (items.length) {
            HF.Util.ajax({
                url: HF.api.batch_delete,
                type: 'POST',
                dataType: 'json',
                data: { paths: JSON.stringify(HF.item_list_paths(items)) },
                success: function(res) {
                    if (!res || res.code !== 0) {
                        HF.set_error_status((res && res.message) || HF.labels.operation_failed);
                        return;
                    }
                    HF.set_status(HF.labels.delete_complete, 'success');
                    HF.refresh_after_write();
                },
                error: function(xhr) {
                    HF.set_error_status(HF.batch_error_message(xhr, HF.labels.operation_failed));
                }
            });
        }
    });
    document.getElementById('fm_target_cancel').addEventListener('click', HF.close_modal);
    document.getElementById('fm_target_confirm').addEventListener('click', HF.confirm_transfer);
    document.getElementById('fm_target_up').addEventListener('click', function() {
        if (HF.state.target_path !== '/') {
            HF.load_target_directory(HF.state.target_parent || '/');
        }
    });
    document.getElementById('fm_content').addEventListener('mousedown', HF.start_marquee_selection);
    document.getElementById('fm_content').addEventListener('contextmenu', function(event) {
        if (HF.event_on_item_content(event)) {
            return;
        }
        event.preventDefault();
        if (!HF.blank_menu_allowed()) {
            return;
        }
        HF.state.context_item = null;
        var writable_page = HF.state.current && HF.state.current.kind === 'directory';
        var current_path = writable_page ? HF.state.current.path : '';
        var system_reason = HF.get_write_block_reason(current_path);
        HF.set_button_state('fm_menu_sort', !writable_page, '');
        HF.update_sort_menu_state();
        HF.set_button_state(
            'fm_menu_new_folder',
            !writable_page || !!HF.get_write_block_reason(current_path),
            system_reason
        );
        HF.set_button_state(
            'fm_menu_new_file',
            !writable_page || !!HF.get_write_block_reason(current_path),
            system_reason
        );
        document.getElementById('fm_menu_paste_here').style.display =
            writable_page && HF.has_clipboard() ? 'flex' : 'none';
        HF.set_button_state(
            'fm_menu_paste_here',
            !writable_page || !HF.can_paste_to_path(current_path),
            system_reason
        );
        HF.set_button_state(
            'fm_menu_upload_here',
            !writable_page || HF.state.uploading || !HF.can_upload_to_path(current_path),
            system_reason
        );
        HF.set_button_state('fm_menu_terminal_here', false, '');
        if (system_reason) {
            HF.set_write_block_status(system_reason);
        }
        HF.show_context_menu('fm_blank_menu', event.clientX, event.clientY);
    });
    document.getElementById('fm_content').addEventListener('dragenter', function(event) {
        if (!HF.state.uploading && HF.state.current && HF.state.current.kind === 'directory' &&
                HF.can_upload_to_path(HF.state.current.path) && HF.is_file_drag(event) && !event.target.closest('.fm-item')) {
            event.preventDefault();
            HF.show_drag_target(this, HF.state.current.path, HF.path_title(HF.state.current.path));
        }
    });
    document.getElementById('fm_content').addEventListener('dragover', function(event) {
        if (!HF.state.uploading && HF.state.current && HF.state.current.kind === 'directory' &&
                HF.can_upload_to_path(HF.state.current.path) && HF.is_file_drag(event) && !event.target.closest('.fm-item')) {
            event.preventDefault();
            event.dataTransfer.dropEffect = 'copy';
        }
    });
    document.getElementById('fm_content').addEventListener('dragleave', function(event) {
        if (!event.relatedTarget || !this.contains(event.relatedTarget)) {
            HF.clear_drag_state();
        }
    });
    document.getElementById('fm_content').addEventListener('drop', function(event) {
        if (!HF.state.uploading && HF.state.current && HF.state.current.kind === 'directory' &&
                HF.can_upload_to_path(HF.state.current.path) && HF.is_file_drag(event) && !event.target.closest('.fm-item')) {
            HF.handle_file_drop(event, HF.state.current.path, HF.path_title(HF.state.current.path));
        }
    });

    HF.bind_toolbar_actions();
    document.getElementById('fm_bookmark_cancel').addEventListener('click', HF.close_modal);
    document.getElementById('fm_bookmark_folder').addEventListener('change', function() {
        var creating = this.value === '__new__';
        document.getElementById('fm_bookmark_folder_new').style.display = creating ? '' : 'none';
        if (creating) {
            document.getElementById('fm_bookmark_folder_new').focus();
        }
    });
    document.getElementById('fm_bookmark_confirm').addEventListener('click', function() { HF.submit_bookmark_dialog(); });
    document.getElementById('fm_menu_bookmark_open').addEventListener('click', function() {
        HF.hide_context_menus();
        var item = HF.state.bookmark_menu_item;
        if (!item) { return; }
        if (item.is_folder) { HF.open_bookmark_folder(item); return; }
        HF.close_anchor_menus(); HF.close_modal(); HF.open_path(item.path, true);
    });
    document.getElementById('fm_menu_bookmark_edit').addEventListener('click', function() {
        HF.hide_context_menus(HF.fav_panel());
        var item = HF.state.bookmark_menu_item;
        if (!item) { return; }
        if (item.is_folder) { HF.open_name_dialog('bm_folder_rename', { folder: item.folder }); return; }
        HF.open_bookmark_editor(item);
    });
    document.getElementById('fm_menu_bookmark_up').addEventListener('click', function() {
        HF.hide_context_menus(HF.fav_panel());
        var item = HF.state.bookmark_menu_item;
        if (!item) { return; }
        if (item.is_folder) { HF.move_bookmark_folder(item.folder, 'up'); return; }
        HF.move_bookmark(item, 'up');
    });
    document.getElementById('fm_menu_bookmark_down').addEventListener('click', function() {
        HF.hide_context_menus(HF.fav_panel());
        var item = HF.state.bookmark_menu_item;
        if (!item) { return; }
        if (item.is_folder) { HF.move_bookmark_folder(item.folder, 'down'); return; }
        HF.move_bookmark(item, 'down');
    });
    document.getElementById('fm_menu_bookmark_delete').addEventListener('click', function() {
        HF.hide_context_menus(HF.fav_panel());
        var item = HF.state.bookmark_menu_item;
        if (!item) { return; }
        if (item.is_folder) { HF.delete_bookmark_folder(item.folder); return; }
        HF.delete_bookmark(item);
    });
    var close_buttons = document.querySelectorAll('.fm-dialog-close');
    for (var close_index = 0; close_index < close_buttons.length; close_index++) {
        close_buttons[close_index].addEventListener('click', HF.close_modal);
    }
    document.addEventListener('dragend', HF.clear_drag_state);
    document.addEventListener('dragover', function(event) {
        if (HF.is_file_drag(event)) {
            event.preventDefault();
        }
    });
    document.addEventListener('drop', function(event) {
        if (HF.is_file_drag(event)) {
            event.preventDefault();
            HF.clear_drag_state();
            HF.set_warning_status(HF.state.uploading ? HF.labels.upload_busy : HF.labels.select_upload_target);
        }
    });
    window.addEventListener('scroll', function(event) {
        HF.hide_item_hover_card();
        if (HF.scroll_inside_overlay(event && event.target)) {
            return;
        }
        HF.hide_context_menus();
    }, true);
    document.addEventListener('keydown', function(event) {
        if (event.key === 'Escape') {
            HF.hide_context_menus();
            HF.close_modal();
        }
    });

    (function() {
        var content = document.getElementById('fm_content');
        var longPressTimer = null;
        var touchStartX = 0;
        var touchStartY = 0;
        var isLongPress = false;
        var isDragging = false;
        var isSelecting = false;
        var scrollInterval = null;
        var SCROLL_THRESHOLD = 50;
        var SCROLL_SPEED = 8;
        
        var DRAG_THRESHOLD = 14;
        var FLICK_VELOCITY = 0.55;   
        var DIRECTION_RATIO = 1.0;   
        var MIN_MARQUEE_DX = 14;     
        var touchStartOnBlank = false;
        var touchStartTime = 0;
        var multiTouch = false;
        var isScrolling = false;
        var scrollStartTop = 0;

        function startScroll(direction) {
            stopScroll();
            scrollInterval = setInterval(function() {
                var scroller = HF.marquee_scroller();
                scroller.scrollTop += direction * SCROLL_SPEED;

                if (isSelecting) {
                    updateMarqueeFromTouch();
                }
            }, 16);
        }

        function stopScroll() {
            if (scrollInterval) {
                clearInterval(scrollInterval);
                scrollInterval = null;
            }
        }

        function updateMarqueeFromTouch() {
            if (!isSelecting) return;

            var touch = window._lastTouch;
            if (!touch) return;

            HF.apply_marquee_selection(touch.clientX, touch.clientY);
        }

        content.addEventListener('touchstart', function(e) {
            
            if (e.touches.length > 1) {
                multiTouch = true;
                if (longPressTimer) {
                    clearTimeout(longPressTimer);
                    longPressTimer = null;
                }
                return;
            }
            multiTouch = false;

            var touch = e.touches[0];

            touchStartTime = Date.now();
            touchStartX = touch.clientX;
            touchStartY = touch.clientY;
            touchStartOnBlank = !HF.is_item_content_at(
                touchStartX,
                touchStartY
            );

            if (!touchStartOnBlank) {
                return;
            }

            if (HF.state.drag_item) {
                return;
            }

            isLongPress = false;
            isDragging = false;
            isSelecting = false;
            isScrolling = false;
            scrollStartTop = HF.marquee_scroller().scrollTop;

            HF.state.selection_dragging = false;
            HF.state.selection_moved = false;

            HF.state.selection_base =
                (e.ctrlKey || e.metaKey)
                    ? HF.selected_items()
                    : [];

            if (!e.ctrlKey && !e.metaKey && !e.shiftKey) {
                HF.clear_selection();
            }

            HF.snapshot_marquee_origin(touchStartX, touchStartY);
            HF.state.selection_anchor =
                HF.state.selection_base.length
                    ? HF.state.selection_base[0]
                    : null;

            if (longPressTimer) {
                clearTimeout(longPressTimer);
            }

            longPressTimer = setTimeout(function() {
                longPressTimer = null;

                if (
                    !isDragging &&
                    touchStartOnBlank &&
                    !HF.state.drag_item
                ) {
                    isLongPress = true;
                    if (HF.blank_menu_allowed()) {
                        HF.show_context_menu(
                            'fm_blank_menu',
                            touchStartX,
                            touchStartY
                        );
                    }
                }
            }, 500);
        }, { passive: true });

        content.addEventListener('touchmove', function(e) {
            
            if (e.cancelable === false) {
                return;
            }
            var touch = e.touches[0];

            window._lastTouch = touch;

            if (HF.state.drag_item) {
                isSelecting = false;
                isDragging = false;
                HF.state.selection_dragging = false;

                if (HF.state.selection_box) {
                    HF.state.selection_box.style.display = 'none';
                }

                var dragClientY = touch.clientY;
                var dragTopDist = dragClientY;
                var dragBottomDist =
                    window.innerHeight - dragClientY;

                if (dragTopDist < SCROLL_THRESHOLD) {
                    startScroll(-1);
                } else if (dragBottomDist < SCROLL_THRESHOLD) {
                    startScroll(1);
                } else {
                    stopScroll();
                }

                return;
            }

            if (!touchStartOnBlank) {
                return;
            }

            var dx = touch.clientX - touchStartX;
            var dy = touch.clientY - touchStartY;
            var absDx = Math.abs(dx);
            var absDy = Math.abs(dy);
            var distance = Math.sqrt(dx * dx + dy * dy);

            if (!isDragging && !isScrolling) {
                if (distance < DRAG_THRESHOLD) {
                    
                    if (distance > 6) {
                        e.preventDefault();
                    }
                    return;
                }

                var velocity = distance / Math.max(1, Date.now() - touchStartTime);
                var wantsMarquee =
                    !multiTouch &&
                    velocity <= FLICK_VELOCITY &&
                    absDx >= MIN_MARQUEE_DX &&
                    absDx >= absDy * DIRECTION_RATIO;

                if (longPressTimer) {
                    clearTimeout(longPressTimer);
                    longPressTimer = null;
                }

                if (wantsMarquee) {
                    isDragging = true;
                    isSelecting = true;
                    HF.state.selection_dragging = true;

                    HF.state.selection_base =
                        HF.state.selection_base.length
                            ? HF.state.selection_base.slice()
                            : [];

                    HF.ensure_selection_box();

                    HF.apply_marquee_selection(
                        touch.clientX,
                        touch.clientY
                    );

                    document
                        .getElementById('fm_content')
                        .classList.add('selecting');
                } else {
                    
                    isScrolling = true;
                    e.preventDefault();
                }
            }

            if (isScrolling) {
                
                e.preventDefault();
                var scroller = HF.marquee_scroller();
                scroller.scrollTop =
                    scrollStartTop + (touchStartY - touch.clientY);
                return;
            }

            if (!isDragging) {
                return;
            }

            e.preventDefault();

            if (longPressTimer) {
                clearTimeout(longPressTimer);
                longPressTimer = null;
            }

            HF.apply_marquee_selection(
                touch.clientX,
                touch.clientY
            );

            var clientY = touch.clientY;
            var topDist = clientY;
            var bottomDist =
                window.innerHeight - clientY;

            if (topDist < SCROLL_THRESHOLD) {
                startScroll(-1);
            } else if (bottomDist < SCROLL_THRESHOLD) {
                startScroll(1);
            } else {
                stopScroll();
            }
        }, { passive: false });

        content.addEventListener('touchend', function(e) {
            if (longPressTimer) {
                clearTimeout(longPressTimer);
                longPressTimer = null;
            }

            stopScroll();
            window._lastTouch = null;

            if (isSelecting) {
                HF.state.selection_dragging = false;

                if (HF.state.selection_box) {
                    HF.state.selection_box.style.display = 'none';
                }

                document
                    .getElementById('fm_content')
                    .classList.remove('selecting');
            }

            if (touchStartOnBlank && !HF.state.drag_item) {
                if (isSelecting) {
                    if (!isDragging && !isLongPress) {
                        HF.clear_selection();
                    }
                } else {
                    if (!isLongPress) {
                        HF.clear_selection();
                    }
                }
            }

            isSelecting = false;
            isDragging = false;
            isScrolling = false;
            isLongPress = false;
            HF.state.selection_dragging = false;
            touchStartOnBlank = false;
        }, { passive: true });
    })();

    
    
    document.addEventListener('keydown', function(event) {
        if (event.key === 'Escape' && HF.window_manager.active &&
                !HF.window_manager.active.legacy && !event.defaultPrevented) {
            event.preventDefault();
            HF.window_manager.close(HF.window_manager.active);
        }
    });

    HF.load_preferences(function() {
        HF.refresh_navigation(function() {
            var restored = false;
            if (HF.state.preferences.restore_last_directory === 1) {
                var last = HF.state.preferences.last_directory || '';
                if (last && last.charAt(0) === '/') {
                    HF.open_path(last, true);
                    restored = true;
                }
            }
            if (!restored) {
                HF.show_virtual('quick_access', true);
            }
        });
    });
})(window.HarborFile);
</script>

{% include('footer') %}
