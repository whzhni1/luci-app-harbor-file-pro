{% include('header') %}
<link rel="stylesheet" href="{{ resource }}/harbor_file_pro/common.css">
<link rel="stylesheet" href="{{ resource }}/harbor_file_pro/css/file-manager.css">
<link rel="stylesheet" href="{{ resource }}/harbor_file_pro/css/window-manager.css">
<link rel="stylesheet" href="{{ resource }}/harbor_file_pro/css/document-windows.css">
<style>
:root { --fm-icon-close: url('{{ resource }}/harbor_file_pro/icons/close.svg'); }
</style>

<script type="text/javascript" src="{{ resource }}/harbor_file_pro/harbor-io.js"></script>
<script type="text/javascript" src="{{ resource }}/harbor_file_pro/hex-source.js"></script>
<script type="text/javascript">
window.HarborFile = {
    init: function (config) {
        this.api = config.api;
        this.io = config.io;
        this.sessionid = config.sessionid;
        this.labels = config.labels;
        this.resource = config.resource;
        return this;
    }
};
HarborFile.init({
    io: '/cgi-bin/harbor-io-pro',
    sessionid: '{{ dispatcher.authsession ?? "" }}',
    api: {
        navigation: '{{ dispatcher.build_url('admin', 'harbor_pro', 'navigation') }}',
        terminal_info: '{{ dispatcher.build_url('admin', 'harbor_pro', 'terminal_info') }}',
