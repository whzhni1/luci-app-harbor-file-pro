<script src="{{ resource }}/harbor_file_pro/js/system-windows.js"></script>
<script src="{{ resource }}/harbor_file_pro/js/file-operations.js"></script>

<div class="file-manager">
    <div class="fm-toolbar">
        <button id="fm_back" class="fm-tool-button" type="button" title="{{ _('Back') }}" aria-label="{{ _('Back') }}">
            <span class="fm-tool-image" style="--fm-icon:url('{{ resource }}/harbor_file_pro/icons/back.svg')" aria-hidden="true"></span>
        </button>
        <button id="fm_forward" class="fm-tool-button" type="button" title="{{ _('Forward') }}" aria-label="{{ _('Forward') }}">
            <span class="fm-tool-image" style="--fm-icon:url('{{ resource }}/harbor_file_pro/icons/forward.svg')" aria-hidden="true"></span>
        </button>
        <button id="fm_up" class="fm-tool-button" type="button" title="{{ _('Up') }}" aria-label="{{ _('Up') }}">
            <span class="fm-tool-image" style="--fm-icon:url('{{ resource }}/harbor_file_pro/icons/up.svg')" aria-hidden="true"></span>
        </button>
        <div id="fm_address" class="fm-address">
            <div id="fm_address_body" class="fm-address-body"></div>
            <button id="fm_address_star" class="fm-address-star" type="button">&#9734;</button>
            <button id="fm_refresh" class="fm-tool-button" type="button" title="{{ _('Refresh') }}" aria-label="{{ _('Refresh') }}">
                <span class="fm-tool-image" style="--fm-icon:url('{{ resource }}/harbor_file_pro/icons/refresh.svg')" aria-hidden="true"></span>
            </button>
        </div>
        <div class="fm-toolbar-tools">
            <span id="fm_select_count" class="fm-select-count"></span>
            <button id="fm_select_mode" class="fm-tool-button fm-select-mode-btn" type="button" title="{{ _('Selection mode') }}" aria-label="{{ _('Selection mode') }}"><span id="fm_select_mode_icon">&#9744;</span></button>
            <button id="fm_select_exit" class="fm-tool-button fm-select-exit-btn" type="button" title="{{ _('Exit selection mode') }}" aria-label="{{ _('Exit selection mode') }}" style="display:none">&#10005;</button>
            <button id="fm_favorites" class="fm-tool-button fm-favorites-button" type="button" data-menu="fm_fav_panel" title="{{ _('Favorites') }}" aria-label="{{ _('Favorites') }}">&#9733;</button>
            <button id="fm_more" class="fm-tool-button fm-more-button" type="button" data-menu="fm_more_menu" title="{{ _('More') }}" aria-label="{{ _('More') }}">&#8943;</button>
        </div>
    </div>

    <div class="fm-layout">
        <aside id="fm_sidebar" class="fm-sidebar"></aside>
        <main id="fm_main" class="fm-main">
            <div id="fm_status" class="fm-status"></div>
            <div id="fm_upload_panel" class="fm-upload-panel">
                <div class="fm-upload-heading">
                    <img src="{{ resource }}/harbor_file_pro/icons/upload.svg" alt="">
                    <div id="fm_upload_title" class="fm-upload-title">-</div>
                    <div id="fm_upload_percent" class="fm-upload-percent">0%</div>
                </div>
                <div class="fm-upload-progress"><span id="fm_upload_progress"></span></div>
                <div id="fm_upload_detail" class="fm-upload-detail">-</div>
                <div id="fm_upload_bytes" class="fm-upload-bytes">-</div>
                <div id="fm_upload_speed" class="fm-upload-speed">-</div>
            </div>
            <div id="fm_drag_overlay" class="fm-drag-overlay"></div>
            <div id="fm_content" class="fm-content"></div>
            <div class="fm-details">
                <div class="fm-detail"><div class="fm-detail-label">{{ _('Name') }}</div><div id="fm_detail_name" class="fm-detail-value">-</div></div>
                <div class="fm-detail"><div class="fm-detail-label">{{ _('Path') }}</div><div id="fm_detail_path" class="fm-detail-value">-</div></div>
                <div class="fm-detail"><div class="fm-detail-label">{{ _('Type') }}</div><div id="fm_detail_type" class="fm-detail-value">-</div></div>
                <div class="fm-detail"><div class="fm-detail-label">{{ _('Size') }}</div><div id="fm_detail_size" class="fm-detail-value">-</div></div>
                <div class="fm-detail"><div class="fm-detail-label">{{ _('Permissions') }}</div><div id="fm_detail_mode" class="fm-detail-value">-</div></div>
                <div class="fm-detail"><div class="fm-detail-label">{{ _('Modified') }}</div><div id="fm_detail_mtime" class="fm-detail-value">-</div></div>
            </div>
        </main>
    </div>
</div>

<input id="fm_upload_input" type="file" multiple hidden style="display:none">

    <div id="fm_fav_panel" class="fm-fav-panel" data-anchor-menu="fm_favorites"></div>

<div id="fm_more_menu" class="fm-tool-dropdown" data-anchor-menu="fm_more">
    <button id="fm_view" type="button">
        <span class="fm-tool-dropdown-icon" style="--fm-icon:url('{{ resource }}/harbor_file_pro/icons/view.svg')" aria-hidden="true"></span>
        <span>{{ _('View') }}</span>
    </button>
    <button id="fm_settings" type="button">
        <span class="fm-tool-dropdown-icon" style="--fm-icon:url('{{ resource }}/harbor_file_pro/icons/settings.svg')" aria-hidden="true"></span>
        <span>{{ _('Settings') }}</span>
    </button>
    <button id="fm_about" type="button">
        <span class="fm-tool-dropdown-icon" style="--fm-icon:url('{{ resource }}/harbor_file_pro/icons/about.svg')" aria-hidden="true"></span>
        <span>{{ _('About') }}</span>
    </button>
</div>

<div id="fm_bookmark_menu" class="fm-context-menu">
    <button id="fm_menu_bookmark_open" type="button"><span>{{ _('Open') }}</span></button>
    <button id="fm_menu_bookmark_edit" type="button"><span>{{ _('Edit') }}</span></button>
    <button id="fm_menu_bookmark_up" type="button"><span>{{ _('Move up') }}</span></button>
    <button id="fm_menu_bookmark_down" type="button"><span>{{ _('Move down') }}</span></button>
    <button id="fm_menu_bookmark_delete" type="button"><span>{{ _('Delete') }}</span></button>
</div>

<div id="fm_item_menu" class="fm-context-menu">
    <button id="fm_menu_open" type="button">
        <span class="fm-menu-image" style="--fm-icon:url('{{ resource }}/harbor_file_pro/icons/open.svg')" aria-hidden="true"></span>
        <span>{{ _('Open') }}</span>
    </button>
<button id="fm_menu_open_binary" type="button">
        <span class="fm-menu-image" style="--fm-icon:url('{{ resource }}/harbor_file_pro/icons/binary.svg')" aria-hidden="true"></span>
        <span>{{ _('Open hexadecimal') }}</span>
    </button>
    <button id="fm_menu_properties" type="button">
        <span class="fm-menu-image" style="--fm-icon:url('{{ resource }}/harbor_file_pro/icons/properties.svg')" aria-hidden="true"></span>
        <span>{{ _('Properties') }}</span>
    </button>
    <button id="fm_menu_terminal" type="button">
        <span class="fm-menu-image" style="--fm-icon:url('{{ resource }}/harbor_file_pro/icons/terminal.svg')" aria-hidden="true"></span>
        <span>{{ _('Terminal') }}</span>
    </button>
    <button id="fm_menu_download" type="button">
        <span class="fm-menu-image" style="--fm-icon:url('{{ resource }}/harbor_file_pro/icons/download.svg')" aria-hidden="true"></span>
        <span>{{ _('Download file') }}</span>
    </button>
    <button id="fm_menu_compress" type="button">
        <span class="fm-menu-image" style="--fm-icon:url('{{ resource }}/harbor_file_pro/icons/archive.svg')" aria-hidden="true"></span>
        <span>{{ _('Compress') }}</span>
    </button>
    <button id="fm_menu_extract" type="button">
        <span class="fm-menu-image" style="--fm-icon:url('{{ resource }}/harbor_file_pro/icons/open.svg')" aria-hidden="true"></span>
        <span>{{ _('Extract') }}</span>
    </button>
    <button id="fm_menu_copy" type="button">
        <span class="fm-menu-image" style="--fm-icon:url('{{ resource }}/harbor_file_pro/icons/copy.svg')" aria-hidden="true"></span>
        <span>{{ _('Copy') }}</span>
    </button>
    <button id="fm_menu_cut" type="button">
        <span class="fm-menu-image" style="--fm-icon:url('{{ resource }}/harbor_file_pro/icons/cut.svg')" aria-hidden="true"></span>
        <span>{{ _('Cut') }}</span>
    </button>
    <button id="fm_menu_paste" type="button">
        <span class="fm-menu-image" style="--fm-icon:url('{{ resource }}/harbor_file_pro/icons/paste.svg')" aria-hidden="true"></span>
        <span>{{ _('Paste') }}</span>
    </button>
    <button id="fm_menu_upload" type="button">
        <span class="fm-menu-image" style="--fm-icon:url('{{ resource }}/harbor_file_pro/icons/upload.svg')" aria-hidden="true"></span>
        <span>{{ _('Upload files') }}</span>
    </button>
    <button id="fm_menu_rename" type="button">
        <span class="fm-menu-image" style="--fm-icon:url('{{ resource }}/harbor_file_pro/icons/rename.svg')" aria-hidden="true"></span>
        <span>{{ _('Rename') }}</span>
    </button>
    <button id="fm_menu_copy_to" type="button">
        <span class="fm-menu-image" style="--fm-icon:url('{{ resource }}/harbor_file_pro/icons/copy.svg')" aria-hidden="true"></span>
        <span>{{ _('Copy to') }}</span>
    </button>
    <button id="fm_menu_move_to" type="button">
        <span class="fm-menu-image" style="--fm-icon:url('{{ resource }}/harbor_file_pro/icons/move.svg')" aria-hidden="true"></span>
        <span>{{ _('Move to') }}</span>
    </button>
    <button id="fm_menu_delete" type="button">
        <span class="fm-menu-image" style="--fm-icon:url('{{ resource }}/harbor_file_pro/icons/delete.svg')" aria-hidden="true"></span>
        <span>{{ _('Delete') }}</span>
    </button>
</div>

    <div id="fm_view_menu" class="fm-context-menu">
    <button type="button" data-view="large"><span>{{ _('Large icons') }}</span></button>
    <button type="button" data-view="medium"><span>{{ _('Medium icons') }}</span></button>
    <button type="button" data-view="small"><span>{{ _('Small icons') }}</span></button>
    <button type="button" data-view="list"><span>{{ _('List') }}</span></button>
    <button type="button" data-view="details"><span>{{ _('Details') }}</span></button>
    <button type="button" data-view="tile"><span>{{ _('Tiles') }}</span></button>
</div>

    <div id="fm_blank_menu" class="fm-context-menu">
    <button id="fm_menu_sort" class="has-submenu" type="button">
        <span class="fm-menu-image placeholder" aria-hidden="true"></span>
        <span>{{ _('Sort by') }}</span>
    </button>
    <button id="fm_menu_new_folder" type="button">
        <span class="fm-menu-image" style="--fm-icon:url('{{ resource }}/harbor_file_pro/icons/new_folder.svg')" aria-hidden="true"></span>
        <span>{{ _('New folder') }}</span>
    </button>
    <button id="fm_menu_new_file" type="button">
        <span class="fm-menu-image" style="--fm-icon:url('{{ resource }}/harbor_file_pro/icons/new_file.svg')" aria-hidden="true"></span>
        <span>{{ _('New file') }}</span>
    </button>
    <button id="fm_menu_paste_here" type="button">
        <span class="fm-menu-image" style="--fm-icon:url('{{ resource }}/harbor_file_pro/icons/paste.svg')" aria-hidden="true"></span>
        <span>{{ _('Paste') }}</span>
    </button>
    <button id="fm_menu_upload_here" type="button">
        <span class="fm-menu-image" style="--fm-icon:url('{{ resource }}/harbor_file_pro/icons/upload.svg')" aria-hidden="true"></span>
        <span>{{ _('Upload files') }}</span>
    </button>
    <button id="fm_menu_terminal_here" type="button">
        <span class="fm-menu-image" style="--fm-icon:url('{{ resource }}/harbor_file_pro/icons/terminal.svg')" aria-hidden="true"></span>
        <span>{{ _('Terminal') }}</span>
    </button>
    <button id="fm_menu_refresh" type="button">
        <span class="fm-menu-image" style="--fm-icon:url('{{ resource }}/harbor_file_pro/icons/refresh.svg')" aria-hidden="true"></span>
        <span>{{ _('Refresh') }}</span>
    </button>
</div>

    <div id="fm_sort_menu" class="fm-context-menu">
    <button type="button" data-sort-field="name"><span>{{ _('Name') }}</span></button>
    <button type="button" data-sort-field="mtime"><span>{{ _('Modified') }}</span></button>
    <button type="button" data-sort-field="type"><span>{{ _('Type') }}</span></button>
    <button type="button" data-sort-field="size"><span>{{ _('Size') }}</span></button>
    <div class="fm-context-menu-separator" role="separator"></div>
    <button type="button" data-sort-order="asc"><span>{{ _('Ascending') }}</span></button>
    <button type="button" data-sort-order="desc"><span>{{ _('Descending') }}</span></button>
</div>

    <div id="fm_modal_mask" class="fm-modal-mask"></div>

<section id="fm_property_dialog" class="fm-dialog" role="dialog" aria-modal="true" aria-labelledby="fm_property_title">
    <div class="fm-dialog-header">
        <div id="fm_property_title" class="fm-dialog-title">{{ _('Properties') }}</div>
        <button class="fm-dialog-close" type="button" aria-label="{{ _('Close') }}">&times;</button>
    </div>
    <div class="fm-property-body">
        <img id="fm_property_icon" class="fm-property-icon" alt="">
        <div class="fm-property-list">
            <div class="fm-property-label">{{ _('Name') }}</div><div id="fm_property_name" class="fm-property-value">-</div>
            <div class="fm-property-label">{{ _('Path') }}</div><div id="fm_property_path" class="fm-property-value">-</div>
            <div class="fm-property-label">{{ _('Type') }}</div><div id="fm_property_type" class="fm-property-value">-</div>
            <div class="fm-property-label">{{ _('Size') }}</div><div id="fm_property_size" class="fm-property-value">-</div>
            <div class="fm-property-label">{{ _('Permissions') }}</div><div id="fm_property_mode" class="fm-property-value fm-flex-row">
                <span id="fm_property_mode_text">-</span>
                <button id="fm_property_edit_mode" class="fm-dialog-action" type="button">{{ _('Edit') }}</button>
            </div>
            <div id="fm_property_mode_edit" style="display:none;">
                <div class="fm-property-label"></div>
                <div class="fm-property-value perm-header">
                    <span>R</span>
                    <span>W</span>
                    <span>X</span>
                </div>
                <div class="fm-property-label">{{ _('Owner') }}</div><div class="fm-property-value perm-checks">
                    <input type="checkbox" class="perm-check">
                    <input type="checkbox" class="perm-check">
                    <input type="checkbox" class="perm-check">
                </div>
                <div class="fm-property-label">{{ _('Group') }}</div><div class="fm-property-value perm-checks">
                    <input type="checkbox" class="perm-check">
                    <input type="checkbox" class="perm-check">
                    <input type="checkbox" class="perm-check">
                </div>
                <div class="fm-property-label">{{ _('Others') }}</div><div class="fm-property-value perm-checks">
                    <input type="checkbox" class="perm-check">
                    <input type="checkbox" class="perm-check">
                    <input type="checkbox" class="perm-check">
                </div>
                <div class="fm-property-label">{{ _('Octal') }}</div><div class="fm-property-value fm-flex-row">
                    <input id="fm_property_mode_input" type="text" size="4" maxlength="4" pattern="[0-7]{3,4}" style="width:50px;">
                    <button id="fm_property_mode_save" class="fm-dialog-action primary" type="button">{{ _('Save') }}</button>
                    <button id="fm_property_mode_cancel" class="fm-dialog-action" type="button">{{ _('Cancel') }}</button>
                </div>
            </div>
            <div class="fm-property-label">{{ _('Modified') }}</div><div id="fm_property_mtime" class="fm-property-value">-</div>
        </div>
    </div>
</section>

<section id="fm_about_dialog" class="fm-dialog" role="dialog" aria-modal="true" aria-labelledby="fm_about_title">
    <div class="fm-dialog-header">
        <div id="fm_about_title" class="fm-dialog-title">{{ _('About') }}</div>
        <button class="fm-dialog-close" type="button" aria-label="{{ _('Close') }}">&times;</button>
    </div>
    <div class="fm-about-body">
        <div class="fm-about-brand">
            <div class="fm-about-icon" aria-hidden="true">
                <span class="fm-tool-image" style="--fm-icon:url('{{ resource }}/harbor_file_pro/icons/about.svg')"></span>
            </div>
            <div>
                <div class="fm-about-name">Harbor File Pro</div>
                <div class="fm-about-subtitle">{{ _('Harbor File is a powerful OpenWrt file management plugin') }}</div>
            </div>
        </div>
        <div class="fm-about-list fm-about-update">
            <div class="fm-about-label">{{ _('Current version') }}</div>
            <div class="fm-about-value" id="fm_about_version">-</div>
            <div class="fm-about-label">{{ _('Latest version') }}</div>
            <div class="fm-about-value">
                <span id="fm_about_latest">…</span>
                <button id="fm_update_start" class="fm-dialog-action primary" type="button" style="display:none">{{ _('Update now') }}</button>
            </div>
            <div class="fm-about-label">{{ _('Mirror') }}</div>
            <div class="fm-about-value">
                <select id="fm_update_mirror" class="fm-form-select fm-update-select">
                    <option value="auto">{{ _('Auto') }}</option>
                    <option value="gitee">Gitee</option>
                    <option value="github">GitHub</option>
                    <option value="gitlab">GitLab</option>
                </select>
                <button id="fm_update_check" class="fm-dialog-action" type="button">{{ _('Check for updates') }}</button>
            </div>
        </div>
        <div class="fm-about-card">
            <div class="fm-about-card-head">
                <span class="fm-about-card-name">Harbor File</span>
                <span class="fm-about-card-tag">{{ _('Original project') }}</span>
            </div>
            <div class="fm-about-list">
                <div class="fm-about-label">{{ _('Author') }}</div>
                <div class="fm-about-value">TT</div>
                <div class="fm-about-label">{{ _('License') }}</div>
                <div class="fm-about-value">MIT License</div>
                <div class="fm-about-label">{{ _('Project address') }}</div>
                <div class="fm-about-value"><a href="https://github.com/destan19/luci-app-harbor-file" target="_blank" rel="noopener">github.com/destan19/luci-app-harbor-file</a></div>
            </div>
        </div>
        <div class="fm-about-card is-pro">
            <div class="fm-about-card-head">
                <span class="fm-about-card-name">Harbor File Pro</span>
                <span class="fm-about-card-tag">{{ _('Enhanced edition') }}</span>
            </div>
            <div class="fm-about-list">
                <div class="fm-about-label">{{ _('Author') }}</div>
                <div class="fm-about-value">whzhni1</div>
                <div class="fm-about-label">{{ _('License') }}</div>
                <div class="fm-about-value">MIT License</div>
                <div class="fm-about-label">{{ _('Project address') }}</div>
                <div class="fm-about-value"><a href="https://github.com/whzhni1/luci-app-harbor-file-pro" target="_blank" rel="noopener">github.com/whzhni1/luci-app-harbor-file-pro</a></div>
            </div>
        </div>
        <div class="fm-about-copyright">Copyright &copy; 2026 FanchmWrt. Harbor File {{ _('All rights reserved.') }}</div>
        <div class="fm-about-copyright">Copyright &copy; 2026 whzhni1. Harbor File Pro {{ _('All rights reserved.') }}</div>
    </div>
</section>

<section id="fm_settings_dialog" class="fm-dialog fm-settings-dialog" role="dialog" aria-modal="true" aria-labelledby="fm_settings_title">
    <div class="fm-dialog-header">
        <div id="fm_settings_title" class="fm-dialog-title">{{ _('Settings') }}</div>
        <button class="fm-dialog-close" type="button" aria-label="{{ _('Close') }}">&times;</button>
    </div>
    <div class="fm-settings-body">
        <div class="fm-settings-shell">
            <div class="fm-settings-menu" role="tablist" aria-label="{{ _('Settings categories') }}">
                <button id="fm_settings_tab_basic" class="fm-settings-menu-item active" type="button" role="tab" aria-selected="true" aria-controls="fm_settings_panel_basic" data-settings-tab="basic">{{ _('Basic settings') }}</button>
                <button id="fm_settings_tab_nginx" class="fm-settings-menu-item" type="button" role="tab" aria-selected="false" aria-controls="fm_settings_panel_nginx" data-settings-tab="nginx">{{ _('Web service') }}</button>
            </div>
            <div class="fm-settings-content">
                <div id="fm_settings_panel_basic" class="fm-settings-panel active" role="tabpanel" aria-labelledby="fm_settings_tab_basic">
                    <div class="fm-settings-panel-main">
                        <div class="fm-settings-row">
                            <div class="fm-settings-copy">
                                <span class="fm-settings-label">{{ _('Default view') }}</span>
                                <div class="fm-settings-desc">{{ _('Choose how files and folders are shown when Harbor File opens.') }}</div>
                            </div>
                            <div class="fm-settings-control-wrap">
                                <select id="fm_settings_view_mode" class="fm-settings-control">
                                    <option value="0">{{ _('Large icons') }}</option>
                                    <option value="1">{{ _('Medium icons') }}</option>
                                    <option value="2">{{ _('Small icons') }}</option>
                                    <option value="3">{{ _('List') }}</option>
                                    <option value="4">{{ _('Details') }}</option>
                                    <option value="5">{{ _('Tiles') }}</option>
                                </select>
                            </div>
                        </div>
                        <div class="fm-settings-row">
                            <div class="fm-settings-copy">
                                <span class="fm-settings-label">{{ _('Home directory') }}</span>
                                <div class="fm-settings-desc">{{ _('Common folders are created under this directory and shown in Quick access.') }}</div>
                            </div>
                            <div class="fm-settings-control-wrap">
                                <input id="fm_settings_home_dir" class="fm-settings-control fm-settings-path-control" type="text" placeholder="/tmp/root">
                            </div>
                        </div>
                        <div class="fm-settings-row">
                            <div class="fm-settings-copy">
                                <span class="fm-settings-label">{{ _('System folder operations') }}</span>
                                <div class="fm-settings-desc">{{ _('Allow create, rename, move, upload and delete actions in protected system folders.') }}</div>
                            </div>
                            <label class="fm-settings-switch" for="fm_settings_system_operations">
                                <input id="fm_settings_system_operations" type="checkbox">
                                <span class="fm-settings-switch-slider"></span>
                            </label>
                        </div>
                        <div class="fm-settings-row">
                            <div class="fm-settings-copy">
                                <span class="fm-settings-label">{{ _('Show hidden files') }}</span>
                                <div class="fm-settings-desc">{{ _('Show Linux hidden files and folders whose names start with a dot.') }}</div>
                            </div>
                            <label class="fm-settings-switch" for="fm_settings_show_hidden">
                                <input id="fm_settings_show_hidden" type="checkbox">
                                <span class="fm-settings-switch-slider"></span>
                            </label>
                        </div>
                        <div class="fm-settings-row">
                            <div class="fm-settings-copy">
                                <span class="fm-settings-label">{{ _('Thumbnails') }}</span>
                                <div class="fm-settings-desc">{{ _('Show cached image thumbnails in icon and tile views. Thumbnails only support image folders. After enabling this option, you can generate thumbnails in image folders.') }}</div>
                            </div>
                            <label class="fm-settings-switch" for="fm_settings_thumbnails">
                                <input id="fm_settings_thumbnails" type="checkbox">
                                <span class="fm-settings-switch-slider"></span>
                            </label>
                        </div>
                        <div class="fm-settings-row">
                            <div class="fm-settings-copy">
