function validJobId(id) {
    return match(id || "", /^[A-Za-z0-9]{20,40}$/);
}

function cleanupJob(dir) {
    unlink(dir + "/request");
    unlink(dir + "/result.tmp");
    unlink(dir + "/result");
    rmdir(dir);
}

function jobRootReady() {
    mkdir(JOB_ROOT, 448);
    let info = stat(JOB_ROOT);
    return info && info.type === "directory" && info.uid === 0 && (info.mode & 511) === 448;
}

function cleanupOldJobs() {
    for (let dir in glob(JOB_ROOT + "/*") || []) {
        let info = stat(dir);
        if (info && info.type === "directory" && time() - info.mtime > 900)
            cleanupJob(dir);
    }
}

function startJob(method, args) {
    if (!jobRootReady()) return { ok: false, error: "job_storage_failed" };
    cleanupOldJobs();
    let random = open("/dev/urandom", "r");
    if (!random) return { ok: false, error: "job_random_failed" };
    let bytes = random.read(24);
    random.close();
    let id = replace(b64enc(bytes || "") || "", /[^A-Za-z0-9]/g, "");
    if (!validJobId(id)) return { ok: false, error: "job_random_failed" };
    let dir = JOB_ROOT + "/" + id;
    if (!mkdir(dir, 448)) return { ok: false, error: "job_storage_failed" };
    if (writefile(dir + "/request", sprintf("%J", { method: method, args: args })) == null) {
        cleanupJob(dir);
        return { ok: false, error: "job_storage_failed" };
    }
    runDetached(sprintf("%s worker %s", shQuote(RPC_SCRIPT), shQuote(id)));
    return { ok: true, job_id: id };
}

function cmdJobStatus(args) {
    let id = `${args.id || ""}`;
    if (!validJobId(id)) return { ok: false, error: "invalid_job" };
    let dir = JOB_ROOT + "/" + id;
    if (!fileExists(dir)) return { ok: false, error: "job_missing" };
    let result = parseJson(readfile(dir + "/result") || "");
    if (!result) return { ok: true, pending: true };
    cleanupJob(dir);
    return { ok: true, pending: false, result: result };
}

function runJob(id) {
    if (!validJobId(id) || !jobRootReady()) return;
    let dir = JOB_ROOT + "/" + id;
    let request = parseJson(readfile(dir + "/request") || "");
    unlink(dir + "/request");
    let result;
    if (!request || !ASYNC_METHODS[request.method] || !METHODS[request.method]) {
        result = { ok: false, error: "invalid_job" };
    } else {
        try {
            result = METHODS[request.method](request.args || {});
        } catch (e) {
            result = { ok: false, error: "rpc_exception" };
        }
    }
    if (writefile(dir + "/result.tmp", sprintf("%J", result)) != null)
        rename(dir + "/result.tmp", dir + "/result");
}

let argv = ARGV;
switch (argv[0]) {
    case "list":
        print(sprintf("%J", SIGNATURES), "\n");
        break;
    case "worker":
        runJob(argv[1]);
        break;
    case "call": {
        let method = argv[1];
        let input = json(readfile("/dev/stdin") ?? "{}") ?? {};
        let fn = method === "job_status" ? cmdJobStatus : METHODS[method];
        if (!fn) {
            print(sprintf("%J", { error: "Unknown method", code: "unknown_method" }), "\n");
        } else {
            try {
                let ret = ASYNC_METHODS[method] ? startJob(method, input) : fn(input);
                print(sprintf("%J", ret), "\n");
            } catch (e) {
                print(sprintf("%J", { error: `${e}`, code: "rpc_exception" }), "\n");
            }
        }
        break;
    }
    default:
        warn(`Usage: ${argv[0]} {list|call <method>}\n`);
        exit(1);
}
